@{
    Layout = null;
    ViewData["Title"] = "Retail365 - Đăng nhập / Đăng ký";
}
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5 CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    />
    <!-- Font Awesome Icon -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/retail365.css" asp-append-version="true" />
  </head>
  <body class="d-flex align-items-center justify-content-center min-vh-100">
    <div class="container py-4">
      <div class="row g-0 main-card overflow-hidden shadow-lg mx-auto">
        <!-- CỘT TRÁI: INTRO PANEL -->
        <div
          class="col-lg-5 left-panel p-4 p-md-5 d-flex flex-column justify-content-between"
        >
          <div>
            <!-- BRAND LOGO PANEL -->
            <div class="d-flex align-items-center gap-2 mb-4">
              <div
                class="brand-icon d-flex align-items-center justify-content-center text-white rounded-3 fs-5"
              >
                <i class="fa-solid fa-store"></i>
              </div>
              <div>
                <div class="d-flex align-items-center gap-2">
                  <span class="fw-bold fs-5 text-white">Retail365</span>
                  <span class="badge bg-amber text-dark fw-bold"
                    >HR Management</span
                  >
                </div>
                <small class="text-white-50 text-uppercase tracking-wider"
                  >QUẢN TRỊ & CHẤM CÔNG CỬA HÀNG</small
                >
              </div>
            </div>

            <!-- Hero Text -->
            <h1 class="fw-bold text-white h2 mb-3">
              Hệ Thống Vận Hành & Chấm Công Chuỗi Bán Lẻ
            </h1>
            <p class="text-white-50 small mb-4">
              Giải pháp điều phối ca kíp, điểm danh QR tức thì cho hơn 350+ điểm
              bán tiện lợi hoạt động liên tục 24/7 trên toàn quốc.
            </p>

            <!-- Feature Cards List -->
            <div class="d-flex flex-column gap-3 mb-4">
              <div
                class="feature-card p-3 rounded-3 d-flex align-items-start gap-3"
              >
                <div
                  class="feature-icon rounded-3 text-white d-flex align-items-center justify-content-center flex-shrink-0"
                >
                  <i class="fa-solid fa-bolt"></i>
                </div>
                <div>
                  <h6 class="fw-bold text-white mb-1 small">
                    Check-in 1 chạm siêu tốc
                  </h6>
                  <p class="text-white-50 extra-small mb-0">
                    Nhân viên quầy quét mã định danh tại kiosk chỉ mất 0.5s để
                    sẵn sàng mở kết tính tiền.
                  </p>
                </div>
              </div>

              <div
                class="feature-card p-3 rounded-3 d-flex align-items-start gap-3"
              >
                <div
                  class="feature-icon rounded-3 text-white d-flex align-items-center justify-content-center flex-shrink-0"
                >
                  <i class="fa-solid fa-location-dot"></i>
                </div>
                <div>
                  <h6 class="fw-bold text-white mb-1 small">
                    Định vị Geofence & WiFi Quầy
                  </h6>
                  <p class="text-white-50 extra-small mb-0">
                    Xác thực thiết bị trong bán kính 15m quầy thu ngân, triệt
                    tiêu hoàn toàn chấm công hộ.
                  </p>
                </div>
              </div>

              <div
                class="feature-card p-3 rounded-3 d-flex align-items-start gap-3"
              >
                <div
                  class="feature-icon rounded-3 text-white d-flex align-items-center justify-content-center flex-shrink-0"
                >
                  <i class="fa-solid fa-arrow-right-arrow-left"></i>
                </div>
                <div>
                  <h6 class="fw-bold text-white mb-1 small">
                    Đồng bộ bảng lương & phụ cấp
                  </h6>
                  <p class="text-white-50 extra-small mb-0">
                    Tự động kết chuyển phụ cấp ca đêm (+30%), ngày nghỉ lễ và
                    thưởng KPI chỉ số doanh số quầy.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CỘT PHẢI: FORM PANEL -->
        <div
          class="col-lg-7 right-panel p-4 p-md-5 d-flex flex-column justify-content-between"
        >
          <div>
            <!-- Tab Switcher Header -->
            <div
              class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2"
            >
              <div
                class="custom-tab-container p-1 rounded-4 d-flex align-items-center"
              >
                <div class="tab-indicator"></div>
                <!-- Nút Đăng Nhập -->
                <button
                  id="btnTabLogin"
                  type="button"
                  class="btn custom-tab-btn active fw-bold text-dark px-3 py-2 border-0"
                >
                  <i
                    class="fa-solid fa-right-to-bracket me-2 text-warning-orange"
                  ></i>
                  Đăng Nhập
                </button>
                <!-- Nút Đăng Ký -->
                <button
                  id="btnTabRegister"
                  type="button"
                  class="btn custom-tab-btn fw-bold text-secondary px-3 py-2 border-0"
                >
                  <i class="fa-solid fa-user-plus me-2"></i> Đăng Ký Tài Khoản
                </button>
              </div>
            </div>

            <!-- TAB 1: FORM ĐĂNG NHẬP -->
            <div id="loginForm" class="form-tab-content active">
              <form asp-controller="Account" asp-action="Login" method="post">
                <!-- Email / Username -->
                <div class="mb-3">
                  <label class="form-label extra-small fw-bold text-secondary">
                    Email đăng nhập <span class="text-danger">*</span>
                  </label>
                  <div class="input-group">
                    <span
                      class="input-group-text bg-light border-end-0 text-muted"
                    >
                      <i class="fa-regular fa-envelope"></i>
                    </span>
                    <input
                      type="email"
                      name="username"
                      id="loginUsername"
                      class="form-control border-start-0 shadow-none fw-semibold"
                      placeholder="Nhập email tài khoản..."
                      required
                    />
                  </div>
                </div>

                <!-- Password -->
                <div class="mb-3">
                  <div
                    class="d-flex justify-content-between align-items-center mb-1"
                  >
                    <label
                      class="form-label extra-small fw-bold text-secondary mb-0"
                    >
                      Mật khẩu truy cập <span class="text-danger">*</span>
                    </label>
                    <a
                      href="#"
                      id="forgotPasswordLink"
                      class="text-decoration-none extra-small text-muted fw-semibold"
                      >Quên mật khẩu?</a
                    >
                  </div>
                  <div class="input-group">
                    <span
                      class="input-group-text bg-light border-end-0 text-muted"
                    >
                      <i class="fa-solid fa-lock"></i>
                    </span>
                    <input
                      type="password"
                      name="password"
                      id="loginPassword"
                      class="form-control border-start-0 border-end-0 shadow-none fw-semibold"
                      placeholder="Nhập mật khẩu (tối thiểu 8 ký tự)..."
                      required
                    />
                    <span
                      class="input-group-text bg-light border-start-0 text-muted"
                      style="cursor: pointer;"
                      onclick="const p = document.getElementById('loginPassword'); p.type = p.type === 'password' ? 'text' : 'password';"
                    >
                      <i class="fa-regular fa-eye"></i>
                    </span>
                  </div>
                </div>

                <!-- Options -->
                <div
                  class="d-flex justify-content-between align-items-center mb-4 extra-small"
                >
                  <div class="form-check">
                    <input
                      class="form-check-input shadow-none"
                      type="checkbox"
                      id="rememberMe"
                      checked
                    />
                    <label
                      class="form-check-label text-secondary fw-semibold"
                      for="rememberMe"
                    >
                      Ghi nhớ đăng nhập trên thiết bị này
                    </label>
                  </div>
                  <span class="text-muted"
                    ><i class="fa-solid fa-shield-halved me-1"></i>Bảo mật 2 lớp
                    (2FA)</span
                  >
                </div>

                <!-- Submit Button -->
                <button
                  type="submit"
                  class="btn btn-orange w-100 py-3 rounded-3 fw-bold fs-6 text-dark shadow-sm d-flex align-items-center justify-content-center gap-2"
                >
                  Đăng Nhập Vào Hệ Thống <i class="fa-solid fa-arrow-right"></i>
                </button>
              </form>

              <div class="position-relative text-center my-4">
                <span class="extra-small text-muted fw-bold"
                  >HOẶC ĐĂNG NHẬP NHANH VỚI</span
                >
              </div>
              <div class="row g-2">
                <div class="col-6">
                  <button
                    type="button"
                    class="btn btn-sso bg-light w-100 py-2 extra-small fw-bold text-dark border d-flex align-items-center justify-content-center gap-2"
                  >
                    <i class="fa-brands fa-google text-danger"></i> Google
                    Workspace
                  </button>
                </div>
                <div class="col-6">
                  <button
                    type="button"
                    class="btn btn-sso bg-light w-100 py-2 extra-small fw-bold text-dark border d-flex align-items-center justify-content-center gap-2"
                  >
                    <i class="fa-brands fa-microsoft text-primary"></i>
                    Microsoft Entra
                  </button>
                </div>
              </div>
            </div>

            <!-- TAB 2: FORM ĐĂNG KÝ -->
            <div id="registerForm" class="form-tab-content d-none">
              <form asp-controller="Account" asp-action="Register" method="post">
                <!-- Họ và tên -->
                <div class="mb-3">
                  <label class="form-label extra-small fw-bold text-secondary">
                    Họ và tên nhân viên <span class="text-danger">*</span>
                  </label>
                  <div class="input-group">
                    <span
                      class="input-group-text bg-light border-end-0 text-muted"
                    >
                      <i class="fa-regular fa-user"></i>
                    </span>
                    <input
                      type="text"
                      name="fullName"
                      class="form-control border-start-0 shadow-none fw-semibold"
                      placeholder="Nguyễn Văn A"
                      required
                    />
                  </div>
                </div>

                <!-- Email doanh nghiệp -->
                <div class="mb-3">
                  <label class="form-label extra-small fw-bold text-secondary">
                    Email doanh nghiệp <span class="text-danger">*</span>
                  </label>
                  <div class="input-group">
                    <span
                      class="input-group-text bg-light border-end-0 text-muted"
                    >
                      <i class="fa-regular fa-envelope"></i>
                    </span>
                    <input
                      type="email"
                      name="email"
                      class="form-control border-start-0 shadow-none fw-semibold"
                      placeholder="employee@retail365.vn"
                      required
                    />
                  </div>
                </div>

                <!-- Số điện thoại -->
                <div class="mb-3">
                  <label class="form-label extra-small fw-bold text-secondary">
                    Số điện thoại liên hệ <span class="text-danger">*</span>
                  </label>
                  <div class="input-group">
                    <span
                      class="input-group-text bg-light border-end-0 text-muted"
                    >
                      <i class="fa-solid fa-phone"></i>
                    </span>
                    <input
                      type="tel"
                      name="phone"
                      class="form-control border-start-0 shadow-none fw-semibold"
                      placeholder="0123 456 789"
                      required
                    />
                  </div>
                </div>

                <!-- Mật khẩu -->
                <div class="mb-3">
                  <label class="form-label extra-small fw-bold text-secondary">
                    Mật khẩu <span class="text-danger">*</span>
                  </label>
                  <div class="input-group">
                    <span
                      class="input-group-text bg-light border-end-0 text-muted"
                    >
                      <i class="fa-solid fa-lock"></i>
                    </span>
                    <input
                      type="password"
                      name="password"
                      class="form-control border-start-0 border-end-0 shadow-none fw-semibold"
                      placeholder="Tối thiểu 8 ký tự..."
                      required
                    />
                    <span
                      class="input-group-text bg-light border-start-0 text-muted"
                    >
                      <i class="fa-regular fa-eye"></i>
                    </span>
                  </div>
                </div>

                <!-- Điều khoản -->
                <div class="mb-4 extra-small">
                  <div class="form-check">
                    <input
                      class="form-check-input shadow-none"
                      type="checkbox"
                      id="termsCheck"
                      required
                      checked
                    />
                    <label
                      class="form-check-label text-secondary fw-semibold"
                      for="termsCheck"
                    >
                      Tôi đồng ý với
                      <a href="#" class="text-dark fw-bold text-decoration-none"
                        >Điều khoản dịch vụ</a
                      >
                      và
                      <a href="#" class="text-dark fw-bold text-decoration-none"
                        >Chính sách bảo mật</a
                      >
                    </label>
                  </div>
                </div>

                <!-- Submit Button -->
                <button
                  type="submit"
                  class="btn btn-orange w-100 py-3 rounded-3 fw-bold fs-6 text-dark shadow-sm d-flex align-items-center justify-content-center gap-2"
                >
                  Đăng Ký Tài Khoản
                  <i class="fa-solid fa-user-check"></i>
                </button>
              </form>
            </div>
          </div>

          <!-- Footer Contact Info -->
          <div
            class="d-flex justify-content-between align-items-center pt-4 border-top mt-4 extra-small text-muted flex-wrap gap-2"
          >
            <div>
              <i class="fa-solid fa-headset me-1"></i> Hotline IT:
              <strong>1900 6828</strong>
            </div>
            <div>Phiên bản Kiosk v4.8.2</div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="modal fade"
      id="forgotPasswordModal"
      tabindex="-1"
      aria-labelledby="forgotPasswordTitle"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
          <div class="modal-header border-0 pb-0">
            <div>
              <h2 id="forgotPasswordTitle" class="modal-title h5 fw-bold">Đặt lại mật khẩu</h2>
              <p id="forgotPasswordSubtitle" class="small text-muted mb-0">
                Nhập email đã đăng ký để nhận mã xác nhận.
              </p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
          </div>
          <div class="modal-body pt-4">
            <div id="forgotPasswordMessage" class="d-none" role="alert"></div>

            <form id="forgotEmailForm" novalidate>
              <label for="forgotEmail" class="form-label small fw-bold">Email tài khoản</label>
              <input
                id="forgotEmail"
                type="email"
                class="form-control"
                autocomplete="email"
                maxlength="254"
                required
              />
              <button type="submit" class="btn btn-orange w-100 mt-4 py-2 fw-bold">
                Gửi mã xác nhận
              </button>
            </form>

            <form id="verifyCodeForm" class="d-none" novalidate>
              <label for="resetCode" class="form-label small fw-bold">Mã xác nhận 6 số</label>
              <input
                id="resetCode"
                type="text"
                class="form-control text-center fs-4 fw-bold"
                inputmode="numeric"
                autocomplete="one-time-code"
                minlength="6"
                maxlength="6"
                pattern="[0-9]{6}"
                required
              />
              <button type="submit" class="btn btn-orange w-100 mt-4 py-2 fw-bold">
                Xác nhận mã
              </button>
              <button id="resendCodeButton" type="button" class="btn btn-link w-100 mt-2 text-muted" disabled>
                Gửi lại mã sau 60 giây
              </button>
            </form>

            <form id="newPasswordForm" class="d-none" novalidate>
              <label for="newPassword" class="form-label small fw-bold">Mật khẩu mới</label>
              <input
                id="newPassword"
                type="password"
                class="form-control"
                autocomplete="new-password"
                minlength="8"
                maxlength="128"
                required
              />
              <label for="confirmNewPassword" class="form-label small fw-bold mt-3">Xác nhận mật khẩu</label>
              <input
                id="confirmNewPassword"
                type="password"
                class="form-control"
                autocomplete="new-password"
                minlength="8"
                maxlength="128"
                required
              />
              <button type="submit" class="btn btn-orange w-100 mt-4 py-2 fw-bold">
                Cập nhật mật khẩu
              </button>
            </form>

            <div id="resetPasswordSuccess" class="d-none text-center py-3">
              <i class="fa-solid fa-circle-check text-success fs-1 mb-3" aria-hidden="true"></i>
              <h3 class="h6 fw-bold">Mật khẩu đã được cập nhật</h3>
              <p class="small text-muted">Bạn có thể đăng nhập bằng mật khẩu mới.</p>
              <button type="button" class="btn btn-orange w-100 py-2 fw-bold" data-bs-dismiss="modal">
                Quay lại đăng nhập
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Script Chuyển Tab & Auth -->
    <script src="~/js/auth.js" asp-append-version="true"></script>
  </body>
</html>
