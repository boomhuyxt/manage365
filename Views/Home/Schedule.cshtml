@{
    Layout = null;
    ViewData["Title"] = "Retail365 - Bảng Phân Công Ca Làm";
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/retail365.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/schedule.css" asp-append-version="true" />
</head>
<body>
    <nav class="schedule-nav no-print" aria-label="Điều hướng chính">
        <a class="brand" href="/">▣ Retail365</a>
        <div><a href="/">Điểm danh QR</a><a href="/Schedule" aria-current="page">Phân ca &amp; nhân sự</a><span id="currentRole"></span><button id="logoutButton" class="btn btn-sm btn-outline-secondary">Đăng xuất</button></div>
    </nav>
    <main class="schedule-page">
        <header class="schedule-header">
            <div><p class="eyebrow">ĐIỀU PHỐI NHÂN SỰ</p><h1>Bảng phân công ca làm việc</h1><p id="weekSubtitle" class="text-secondary mb-0"></p></div>
            <div class="actions no-print"><button id="printButton" class="btn btn-outline-secondary">In lịch</button><button id="copyWeekButton" class="btn btn-outline-secondary manager-only" disabled>Sao chép tuần</button><button id="addShiftButton" class="btn btn-orange manager-only" disabled>+ Phân ca mới</button></div>
        </header>
        <div id="pageMessage" class="alert d-none" role="status" aria-live="polite"></div>
        <section class="schedule-stats" aria-label="Thống kê lịch đang hiển thị">
            <article><span>NHÂN VIÊN</span><strong id="employeeCount">—</strong><small>Trong danh sách đang lọc</small></article>
            <article><span>CA TRONG TUẦN</span><strong id="shiftCount">—</strong><small>Ca chưa hủy của nhóm đang lọc</small></article>
            <article><span>ĐÃ ĐƯỢC PHÂN CA</span><strong id="assignedCount">—</strong><small>Nhân viên có ít nhất một ca</small></article>
            <article><span>CHƯA CÓ CA</span><strong id="unassignedCount">—</strong><small>Nhân viên trong tuần đang chọn</small></article>
        </section>
        <section class="schedule-toolbar no-print" aria-label="Bộ lọc lịch">
            <div class="actions"><button id="previousWeek" class="btn btn-outline-secondary" aria-label="Tuần trước">‹</button><strong id="currentWeekDisplay"></strong><button id="nextWeek" class="btn btn-outline-secondary" aria-label="Tuần sau">›</button><button id="todayButton" class="btn btn-outline-secondary">Hôm nay</button></div>
            <div class="actions"><label class="visually-hidden" for="departmentFilter">Phòng ban</label><select id="departmentFilter" class="form-select"><option value="">Tất cả phòng ban</option></select><label class="visually-hidden" for="searchStaffInput">Tìm nhân viên</label><input id="searchStaffInput" class="form-control" type="search" placeholder="Tên hoặc mã nhân viên…" maxlength="150" /><button id="refreshButton" class="btn btn-outline-secondary">Tải lại</button></div>
        </section>
        <section class="schedule-board" aria-label="Lịch tuần">
            <div class="board-caption"><span id="templateLegend">Đang tải mẫu ca…</span><small class="manager-only">Chọn ca để sửa; chọn dấu + để thêm ca.</small></div>
            <div id="loadingState" class="p-4 text-center" role="status">Đang tải lịch làm việc…</div>
            <div class="table-responsive"><table class="schedule-table"><caption class="visually-hidden">Lịch phân ca theo nhân viên và ngày</caption><thead id="scheduleTableHead"></thead><tbody id="scheduleTableBody"></tbody></table></div>
        </section>
        <p class="text-secondary small mt-3">Ngày và giờ theo Việt Nam (UTC+7). Ô trống là chưa phân ca, không phải nghỉ phép.</p>
    </main>

    <div class="modal fade" id="shiftModal" tabindex="-1" aria-labelledby="shiftModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content">
            <form id="shiftForm">
                <div class="modal-header"><h2 class="modal-title fs-5" id="shiftModalTitle">Phân ca mới</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
                <div class="modal-body">
                    <div id="shiftMessage" class="alert d-none" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-md-6"><span class="form-label">Nhân viên nhận ca</span><div id="shiftEmployees" class="border rounded p-2 overflow-auto" style="max-height:180px" role="group" aria-label="Chọn nhân viên nhận ca"></div><small id="selectedEmployeeCount" class="text-secondary"></small></div>
                        <div class="col-md-6"><label for="shiftDate" class="form-label">Ngày làm việc</label><input id="shiftDate" type="date" class="form-control" required /></div>
                        <div class="col-12"><label for="shiftTemplate" class="form-label">Ca mẫu</label><select id="shiftTemplate" class="form-select"><option value="">Tự chọn giờ</option></select></div>
                        <div class="col-12"><label for="shiftName" class="form-label">Tên ca</label><input id="shiftName" class="form-control" maxlength="150" required value="Ca tùy chỉnh" /></div>
                        <div class="col-6">
                            <label class="form-label">Bắt đầu</label>
                            <div class="d-flex gap-1 align-items-center">
                                <select id="shiftStartHour" class="form-select form-select-sm" required style="width:auto">@for(int h=0;h<24;h++){<option value="@h.ToString("D2")">@h.ToString("D2")</option>}</select>
                                <span class="fw-bold">:</span>
                                <select id="shiftStartMinute" class="form-select form-select-sm" required style="width:auto">@for(int m=0;m<60;m++){<option value="@m.ToString("D2")">@m.ToString("D2")</option>}</select>
                                <span class="badge bg-dark ms-1">24H</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Kết thúc</label>
                            <div class="d-flex gap-1 align-items-center">
                                <select id="shiftEndHour" class="form-select form-select-sm" required style="width:auto">@for(int h=0;h<24;h++){<option value="@h.ToString("D2")">@h.ToString("D2")</option>}</select>
                                <span class="fw-bold">:</span>
                                <select id="shiftEndMinute" class="form-select form-select-sm" required style="width:auto">@for(int m=0;m<60;m++){<option value="@m.ToString("D2")">@m.ToString("D2")</option>}</select>
                                <span class="badge bg-dark ms-1">24H</span>
                            </div>
                        </div>
                        <div class="col-12"><label class="form-check"><input id="shiftOvernight" class="form-check-input" type="checkbox" /><span class="form-check-label">Kết thúc vào ngày hôm sau</span></label></div>
                        <div class="col-12" id="splitShiftSection"><div id="splitIntervals"></div><button type="button" id="addIntervalButton" class="btn btn-sm btn-outline-secondary">+ Thêm khoảng làm (ca gãy)</button><p class="small text-secondary mt-1">Mỗi khoảng được lưu riêng. Khoảng nghỉ không tính là đang làm.</p></div>
                        <div class="col-12"><div id="coveragePreview" class="small border rounded p-2 bg-light" role="status" aria-live="polite">Chọn nhân viên để xem số người làm cùng giờ.</div></div>
                        <div class="col-12"><label for="shiftNote" class="form-label">Ghi chú</label><textarea id="shiftNote" class="form-control" maxlength="2000" rows="2"></textarea></div>
                        <div class="col-12" id="repeatDays"><fieldset><legend class="fs-6">Áp dụng thêm cho ngày khác trong tuần</legend><div id="repeatDayOptions" class="d-flex gap-3 flex-wrap"></div></fieldset></div>
                    </div>
                    <p id="attendanceLock" class="small text-secondary mt-3 d-none">Ca đã có chấm công nên không được sửa hoặc hủy.</p>
                </div>
                <div class="modal-footer"><button id="deleteShiftButton" type="button" class="btn btn-outline-danger me-auto d-none">Hủy ca</button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button><button id="saveShiftButton" type="submit" class="btn btn-orange">Kiểm tra &amp; lưu ca</button></div>
            </form>
        </div></div>
    </div>
    <div class="modal fade" id="copyModal" tabindex="-1" aria-labelledby="copyModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <form id="copyForm"><div class="modal-header"><h2 id="copyModalTitle" class="modal-title fs-5">Sao chép lịch tuần</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div class="modal-body"><p id="copySource"></p><p class="small text-secondary">Sao chép toàn bộ nhân viên của tuần nguồn, giữ giờ đã phân. Ca xung đột sẽ bị bỏ qua và được báo riêng.</p><label for="copyTarget" class="form-label">Thứ Hai của tuần đích</label><input id="copyTarget" type="date" class="form-control" required /><div id="copyMessage" class="alert d-none mt-3" role="alert"></div></div>
        <div class="modal-footer"><button id="copySubmit" class="btn btn-orange" type="submit">Sao chép</button></div></form>
    </div></div></div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/schedule.js" asp-append-version="true"></script>
</body>
</html>
