@{
    Layout = null;
    ViewData["Title"] = "Retail365 - Bảng Phân Công Ca Làm";
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/retail365.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/schedule.css" asp-append-version="true" />
</head>
<body>
        <nav class="app-header no-print" aria-label="Điều hướng chính">
      <a class="app-brand" href="/" aria-label="Retail365 - trang chấm công"><span class="app-brand-mark">R</span><span>Retail365</span><span class="app-branch" data-owner-shop hidden></span></a>
      <div class="app-header-right">
        <div class="app-nav-links"><a data-page="qr" href="/">Điểm danh QR</a><a data-page="schedule" href="/Schedule">Phân ca &amp; nhân sự</a><a data-page="leave" href="/LeaveRequests">Duyệt nghỉ phép</a><a data-page="admin" data-admin-only hidden href="/AdminUsers">Quản trị quyền</a></div>
        <div class="app-account" aria-label="Tài khoản đang đăng nhập"><span id="accountAvatar" class="app-account-avatar" aria-hidden="true">…</span><span class="app-account-copy"><span id="accountName" class="app-account-name">Đang tải tài khoản…</span><span id="accountRole" class="app-account-role">Đang xác thực</span></span></div>
        <button id="logoutButton" type="button" class="app-logout">Đăng xuất</button>
      </div>
    </nav>
    <main class="schedule-page">
        <header class="schedule-header">
            <div><p class="eyebrow">ĐIỀU PHỐI NHÂN SỰ</p><h1>Bảng phân công ca làm việc</h1><p id="weekSubtitle" class="text-secondary mb-0"></p></div>
            <div class="actions no-print"><button id="printButton" class="btn btn-outline-secondary">In lịch</button><button id="copyWeekButton" class="btn btn-outline-secondary manager-only" disabled>Sao chép tuần</button><button id="aiScheduleButton" class="btn btn-primary manager-only" disabled><i class="fa-solid fa-wand-magic-sparkles me-1"></i>AI Xếp ca tự động</button><button id="addShiftButton" class="btn btn-orange manager-only" disabled>+ Phân ca mới</button></div>
        </header>
        <div id="pageMessage" class="alert d-none" role="status" aria-live="polite"></div>
        <section class="schedule-stats" aria-label="Thống kê lịch đang hiển thị">
            <article><span>NHÂN VIÊN</span><strong id="employeeCount">—</strong><small>Trong danh sách đang lọc</small></article>
            <article><span>CA TRONG TUẦN</span><strong id="shiftCount">—</strong><small>Ca chưa hủy của nhóm đang lọc</small></article>
            <article><span>ĐÃ ĐƯỢC PHÂN CA</span><strong id="assignedCount">—</strong><small>Nhân viên có ít nhất một ca</small></article>
            <article><span>CHƯA CÓ CA</span><strong id="unassignedCount">—</strong><small>Nhân viên trong tuần đang chọn</small></article>
        </section>
        <section class="schedule-toolbar no-print" aria-label="Bộ lọc lịch">
            <div class="actions"><button id="previousWeek" class="btn btn-outline-secondary" aria-label="Tuần trước">‹</button><strong id="currentWeekDisplay"></strong><button id="nextWeek" class="btn btn-outline-secondary" aria-label="Tuần sau">›</button><button id="todayButton" class="btn btn-outline-secondary">Hôm nay</button></div>
            <div class="actions"><label class="visually-hidden" for="departmentFilter">Phòng ban</label><select id="departmentFilter" class="form-select"><option value="">Tất cả phòng ban</option></select><label class="visually-hidden" for="searchStaffInput">Tìm nhân viên</label><input id="searchStaffInput" class="form-control" type="search" placeholder="Tên hoặc mã nhân viên…" maxlength="150" /><button id="refreshButton" class="btn btn-outline-secondary">Tải lại</button></div>
        </section>
        <section class="schedule-board" aria-label="Lịch tuần">
            <div class="board-caption"><span id="templateLegend">Đang tải mẫu ca…</span><small class="manager-only">Chọn ca để sửa; chọn dấu + để thêm ca.</small></div>
            <div id="loadingState" class="p-4 text-center" role="status">Đang tải lịch làm việc…</div>
            <div class="table-responsive"><table class="schedule-table"><caption class="visually-hidden">Lịch phân ca theo nhân viên và ngày</caption><thead id="scheduleTableHead"></thead><tbody id="scheduleTableBody"></tbody></table></div>
        </section>
        <p class="text-secondary small mt-3">Ngày và giờ theo Việt Nam (UTC+7). Ô trống là chưa phân ca, không phải nghỉ phép.</p>
    </main>

    <div class="modal fade" id="shiftModal" tabindex="-1" aria-labelledby="shiftModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content">
            <form id="shiftForm">
                <div class="modal-header"><h2 class="modal-title fs-5" id="shiftModalTitle">Phân ca mới</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
                <div class="modal-body">
                    <div id="shiftMessage" class="alert d-none" role="alert"></div>
                    <div class="mb-3"><label for="shiftShop" class="form-label">Cửa hàng phụ trách ca</label><select id="shiftShop" class="form-select" required></select><small class="text-secondary">BLE tự nhận diện nhân viên tại kiosk của cửa hàng này. Ca cũ chưa có cửa hàng cần xác nhận và lưu lại.</small></div>
                    <div class="row g-3">
                        <div class="col-md-6"><span class="form-label">Nhân viên nhận ca</span><div id="shiftEmployees" class="border rounded p-2 overflow-auto" style="max-height:180px" role="group" aria-label="Chọn nhân viên nhận ca"></div><small id="selectedEmployeeCount" class="text-secondary"></small></div>
                        <div class="col-md-6"><label for="shiftDate" class="form-label">Ngày làm việc</label><input id="shiftDate" type="date" class="form-control" required /></div>
                        <div class="col-12"><label for="shiftTemplate" class="form-label">Ca mẫu</label><select id="shiftTemplate" class="form-select"><option value="">Tự chọn giờ</option></select></div>
                        <div class="col-12"><label for="shiftName" class="form-label">Tên ca</label><input id="shiftName" class="form-control" maxlength="150" required value="Ca tùy chỉnh" /></div>
                        <div class="col-6">
                            <label class="form-label">Bắt đầu</label>
                            <div class="d-flex gap-1 align-items-center">
                                <select id="shiftStartHour" class="form-select form-select-sm" required style="width:auto">@for(int h=0;h<24;h++){<option value="@h.ToString("D2")">@h.ToString("D2")</option>}</select>
                                <span class="fw-bold">:</span>
                                <select id="shiftStartMinute" class="form-select form-select-sm" required style="width:auto">@for(int m=0;m<60;m++){<option value="@m.ToString("D2")">@m.ToString("D2")</option>}</select>
                                <span class="badge bg-dark ms-1">24H</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Kết thúc</label>
                            <div class="d-flex gap-1 align-items-center">
                                <select id="shiftEndHour" class="form-select form-select-sm" required style="width:auto">@for(int h=0;h<24;h++){<option value="@h.ToString("D2")">@h.ToString("D2")</option>}</select>
                                <span class="fw-bold">:</span>
                                <select id="shiftEndMinute" class="form-select form-select-sm" required style="width:auto">@for(int m=0;m<60;m++){<option value="@m.ToString("D2")">@m.ToString("D2")</option>}</select>
                                <span class="badge bg-dark ms-1">24H</span>
                            </div>
                        </div>
                        <div class="col-12"><label class="form-check"><input id="shiftOvernight" class="form-check-input" type="checkbox" /><span class="form-check-label">Kết thúc vào ngày hôm sau</span></label></div>
                        <div class="col-12" id="splitShiftSection"><div id="splitIntervals"></div><button type="button" id="addIntervalButton" class="btn btn-sm btn-outline-secondary">+ Thêm khoảng làm (ca gãy)</button><p class="small text-secondary mt-1">Mỗi khoảng được lưu riêng. Khoảng nghỉ không tính là đang làm.</p></div>
                        <div class="col-12"><div id="coveragePreview" class="small border rounded p-2 bg-light" role="status" aria-live="polite">Chọn nhân viên để xem số người làm cùng giờ.</div></div>
                        <div class="col-12"><label for="shiftNote" class="form-label">Ghi chú</label><textarea id="shiftNote" class="form-control" maxlength="2000" rows="2"></textarea></div>
                        <div class="col-12" id="repeatDays"><fieldset><legend class="fs-6">Áp dụng thêm cho ngày khác trong tuần</legend><div id="repeatDayOptions" class="d-flex gap-3 flex-wrap"></div></fieldset></div>
                    </div>
                    <p id="attendanceLock" class="small text-secondary mt-3 d-none">Ca đã có chấm công nên không được sửa hoặc hủy.</p>
                </div>
                <div class="modal-footer"><button id="deleteShiftButton" type="button" class="btn btn-outline-danger me-auto d-none">Hủy ca</button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button><button id="saveShiftButton" type="submit" class="btn btn-orange">Kiểm tra &amp; lưu ca</button></div>
            </form>
        </div></div>
    </div>
    <!-- MODAL AI TỰ ĐỘNG XẾP LỊCH CA LÀM -->
    <div class="modal fade" id="aiScheduleModal" tabindex="-1" aria-labelledby="aiScheduleModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white border-0 py-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-warning text-dark fs-6 px-2 py-1"><i class="fa-solid fa-wand-magic-sparkles"></i> AI</span>
                        <h2 id="aiScheduleModalTitle" class="modal-title fs-5 fw-bold mb-0 text-white">AI Tự động xếp lịch ca làm việc tối ưu</h2>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body p-4">
                    <div id="aiScheduleFeedback" class="alert d-none" role="alert"></div>

                    <!-- STEP 1: CẤU HÌNH XẾP LỊCH -->
                    <div id="aiStepConfig">
                        <div class="alert alert-info border-0 shadow-sm d-flex align-items-start gap-3 mb-4">
                            <i class="fa-solid fa-circle-info fs-4 text-primary mt-1"></i>
                            <div>
                                <strong class="d-block mb-1">Thuật toán AI phân bổ ca thông minh:</strong>
                                <span>Tự động cân bằng tải công việc giữa các nhân viên, bảo đảm thời gian nghỉ chuyển ca tối thiểu 12 tiếng theo Bộ luật Lao động 2019, tự động bảo vệ ngày nghỉ phép đã được duyệt và tối ưu độ phủ ca bán lẻ/POS.</span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="aiWeekStart" class="form-label fw-bold">Tuần làm việc cần xếp (Thứ Hai)</label>
                                <input id="aiWeekStart" type="date" class="form-control" required />
                                <small class="text-secondary">Mặc định là tuần đang hiển thị trên bảng phân ca.</small>
                            </div>
                            <div class="col-md-6">
                                <label for="aiShiftShop" class="form-label fw-bold">Cửa hàng / Chi nhánh áp dụng</label>
                                <select id="aiShiftShop" class="form-select"></select>
                            </div>

                            <div class="col-md-6">
                                <label for="aiMinStaff" class="form-label fw-bold">Định mức nhân sự tối thiểu / mỗi ca</label>
                                <div class="input-group">
                                    <input id="aiMinStaff" type="number" class="form-control" min="1" max="10" value="1" required />
                                    <span class="input-group-text">người / ca</span>
                                </div>
                                <small class="text-secondary">Đảm bảo mỗi ca làm trong ngày có ít nhất số lượng nhân viên này trực.</small>
                            </div>

                            <div class="col-md-6">
                                <label for="aiMaxShifts" class="form-label fw-bold">Giới hạn ca tối đa / nhân viên / tuần</label>
                                <div class="input-group">
                                    <input id="aiMaxShifts" type="number" class="form-control" min="1" max="7" value="6" required />
                                    <span class="input-group-text">ca / tuần</span>
                                </div>
                                <small class="text-secondary">Tuân thủ Luật Lao động (đảm bảo ít nhất 1 ngày nghỉ trọn vẹn trong tuần).</small>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold mb-2">Các ca mẫu đưa vào tính toán AI</label>
                                <div id="aiTemplatesContainer" class="d-flex gap-3 flex-wrap p-3 border rounded bg-light">
                                    <!-- Rendered dynamically -->
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="p-3 border rounded bg-white shadow-sm">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="aiKeepExisting" checked />
                                        <label class="form-check-label fw-semibold" for="aiKeepExisting">
                                            Giữ nguyên các ca làm việc đã xếp trước đó (AI chỉ bù đắp các ca còn thiếu nhân sự)
                                        </label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="aiRespectLeave" checked disabled />
                                        <label class="form-check-label fw-semibold" for="aiRespectLeave">
                                            Tự động loại trừ nhân viên có đơn nghỉ phép đã duyệt (Quy chuẩn bắt buộc)
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2: PREVIEW & AI INSIGHTS -->
                    <div id="aiStepPreview" class="d-none">
                        <div class="card border-0 bg-primary-subtle p-3 mb-3 shadow-sm rounded-3">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div>
                                    <h3 class="h6 fw-bold text-primary mb-1"><i class="fa-solid fa-sparkles me-1"></i>Đánh giá từ AI Manage365</h3>
                                    <p id="aiSummaryText" class="mb-0 text-dark small"></p>
                                </div>
                                <div class="d-flex gap-3 text-center">
                                    <div class="bg-white px-3 py-2 rounded border">
                                        <div class="extra-small text-secondary fw-bold">CA ĐỀ XUẤT</div>
                                        <strong id="aiStatsShifts" class="fs-5 text-primary">0</strong>
                                    </div>
                                    <div class="bg-white px-3 py-2 rounded border">
                                        <div class="extra-small text-secondary fw-bold">NHÂN VIÊN</div>
                                        <strong id="aiStatsStaff" class="fs-5 text-success">0</strong>
                                    </div>
                                    <div class="bg-white px-3 py-2 rounded border">
                                        <div class="extra-small text-secondary fw-bold">TRUNG BÌNH</div>
                                        <strong id="aiStatsAvg" class="fs-5 text-warning-orange">0 ca/người</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <h4 class="h6 fw-bold mb-2"><i class="fa-solid fa-list-check text-success me-1"></i>Chi tiết phân tích &amp; Ràng buộc:</h4>
                            <div id="aiInsightsList" class="d-flex flex-column gap-1"></div>
                        </div>

                        <div id="aiWarningsContainer" class="alert alert-warning d-none mb-3" role="alert">
                            <strong class="d-block mb-1"><i class="fa-solid fa-triangle-exclamation me-1"></i>Cảnh báo thiếu hụt định mức:</strong>
                            <ul id="aiWarningsList" class="mb-0 ps-3 small"></ul>
                        </div>

                        <div class="mb-2 d-flex justify-content-between align-items-center">
                            <h4 class="h6 fw-bold mb-0">Danh sách các ca phân công dự kiến:</h4>
                            <span id="aiProposedCountBadge" class="badge bg-secondary"></span>
                        </div>
                        <div class="table-responsive border rounded" style="max-height: 320px;">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Thứ / Ngày</th>
                                        <th>Nhân viên</th>
                                        <th>Ca làm việc</th>
                                        <th>Thời gian</th>
                                        <th>Lý do &amp; Căn cứ AI</th>
                                    </tr>
                                </thead>
                                <tbody id="aiProposedTableBody">
                                    <!-- Rendered dynamically -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light border-0 py-3">
                    <button id="aiModalCloseBtn" type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button id="aiBackToConfigBtn" type="button" class="btn btn-outline-secondary d-none">
                        <i class="fa-solid fa-arrow-left me-1"></i>Điều chỉnh tham số
                    </button>
                    <button id="aiGenerateBtn" type="button" class="btn btn-primary">
                        <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Bắt đầu AI phân tích &amp; xếp lịch
                    </button>
                    <button id="aiApplyBtn" type="button" class="btn btn-orange d-none">
                        <i class="fa-solid fa-check-double me-1"></i>Xác nhận áp dụng vào lịch tuần
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="copyModal" tabindex="-1" aria-labelledby="copyModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <form id="copyForm"><div class="modal-header"><h2 id="copyModalTitle" class="modal-title fs-5">Sao chép lịch tuần</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div class="modal-body"><p id="copySource"></p><p class="small text-secondary">Sao chép toàn bộ nhân viên của tuần nguồn, giữ giờ đã phân. Ca xung đột sẽ bị bỏ qua và được báo riêng.</p><label for="copyTarget" class="form-label">Thứ Hai của tuần đích</label><input id="copyTarget" type="date" class="form-control" required /><div id="copyMessage" class="alert d-none mt-3" role="alert"></div></div>
        <div class="modal-footer"><button id="copySubmit" class="btn btn-orange" type="submit">Sao chép</button></div></form>
    </div></div></div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app-header.js" asp-append-version="true"></script>
    <script src="~/js/schedule.js" asp-append-version="true"></script>

    <partial name="_ChatBotWidget" />
</body>
</html>
