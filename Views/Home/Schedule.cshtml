    <!-- MODAL: PHÂN CA / ĐỔI CA MỚI -->
    <div
      class="modal fade"
      id="modalAddShift"
      tabindex="-1"
      aria-labelledby="modalAddShiftLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
          <div class="modal-header border-bottom px-4 pt-4 pb-3">
            <div class="d-flex align-items-center gap-2">
              <div class="bg-warning-subtle text-warning-orange p-2 rounded-3">
                <i class="fa-solid fa-calendar-plus fs-5"></i>
              </div>
              <div>
                <h6
                  class="modal-title fw-bold text-dark mb-0"
                  id="modalAddShiftLabel"
                >
                  Phân Công / Đổi Ca Làm
                </h6>
                <small class="text-muted extra-small"
                  >Cập nhật lịch làm việc nhân sự quầy Retail365</small
                >
              </div>
            </div>
            <button
              type="button"
              class="btn-close shadow-none"
              data-bs-dismiss="modal"
              aria-label="Đóng"
            ></button>
          </div>
          <div class="modal-body px-4 py-3">
            <form id="shiftAssignmentForm" onsubmit="handleSaveShift(event)">
              <!-- Chọn nhân viên -->
              <div class="mb-3">
                <label class="form-label extra-small fw-bold text-secondary">
                  Chọn Nhân Viên <span class="text-danger">*</span>
                </label>
                <select
                  class="form-select shadow-none extra-small fw-semibold"
                  id="shiftStaffSelect"
                  required
                >
                  <option value="Trần Minh Khang">
                    Trần Minh Khang (QM-10101 - Trưởng Ca)
                  </option>
                  <option value="Nguyễn Thảo My" selected>
                    Nguyễn Thảo My (QM-88219 - Thu Ngân)
                  </option>
                  <option value="Lê Hoàng Long">
                    Lê Hoàng Long (QM-77342 - Thu Ngân Đêm)
                  </option>
                  <option value="Phạm Gia Hân">
                    Phạm Gia Hân (QM-55410 - Bán Hàng)
                  </option>
                  <option value="Đỗ Quốc Huy">
                    Đỗ Quốc Huy (QM-66129 - Bán Hàng)
                  </option>
                  <option value="Vũ Đức Anh">
                    Vũ Đức Anh (QM-33019 - Kiểm Kho)
                  </option>
                </select>
              </div>

              <!-- Chọn ngày làm việc -->
              <div class="mb-3">
                <label class="form-label extra-small fw-bold text-secondary">
                  Ngày Áp Dụng <span class="text-danger">*</span>
                </label>
                <select
                  class="form-select shadow-none extra-small fw-semibold"
                  id="shiftDaySelect"
                  required
                >
                  <option value="Thứ Hai">Thứ Hai (15/09)</option>
                  <option value="Thứ Ba">Thứ Ba (16/09)</option>
                  <option value="Thứ Tư">Thứ Tư (17/09)</option>
                  <option value="Thứ Năm">Thứ Năm (18/09)</option>
                  <option value="Thứ Sáu">Thứ Sáu (19/09)</option>
                  <option value="Thứ Bảy" selected>
                    Thứ Bảy - Hôm Nay (20/09)
                  </option>
                  <option value="Chủ Nhật">Chủ Nhật (21/09)</option>
                </select>
              </div>

              <!-- Loại ca -->
              <div class="mb-3">
                <label class="form-label extra-small fw-bold text-secondary">
                  Ca Làm Việc <span class="text-danger">*</span>
                </label>
                <div class="d-flex flex-column gap-2">
                  <div
                    class="form-check p-2 border rounded-3 bg-light d-flex align-items-center gap-2"
                  >
                    <input
                      class="form-check-input ms-0 mt-0"
                      type="radio"
                      name="shiftTypeRadio"
                      id="radioMorning"
                      value="morning"
                      checked
                    />
                    <label
                      class="form-check-label extra-small fw-bold text-dark w-100"
                      for="radioMorning"
                    >
                      <i class="fa-regular fa-sun text-warning me-1"></i> Ca
                      Sáng (06:00 - 14:00)
                    </label>
                  </div>
                  <div
                    class="form-check p-2 border rounded-3 bg-light d-flex align-items-center gap-2"
                  >
                    <input
                      class="form-check-input ms-0 mt-0"
                      type="radio"
                      name="shiftTypeRadio"
                      id="radioAfternoon"
                      value="afternoon"
                    />
                    <label
                      class="form-check-label extra-small fw-bold text-dark w-100"
                      for="radioAfternoon"
                    >
                      <i class="fa-solid fa-cloud-sun text-primary me-1"></i> Ca
                      Chiều (14:00 - 22:00)
                    </label>
                  </div>
                  <div
                    class="form-check p-2 border rounded-3 bg-light d-flex align-items-center gap-2"
                  >
                    <input
                      class="form-check-input ms-0 mt-0"
                      type="radio"
                      name="shiftTypeRadio"
                      id="radioNight"
                      value="night"
                    />
                    <label
                      class="form-check-label extra-small fw-bold text-dark w-100"
                      for="radioNight"
                    >
                      <i
                        class="fa-regular fa-moon text-purple me-1"
                        style="color: #6d28d9"
                      ></i>
                      Ca Đêm (22:00 - 06:00)
                      <span class="badge bg-danger ms-1">+30% Phụ Cấp</span>
                    </label>
                  </div>
                  <div
                    class="form-check p-2 border rounded-3 bg-light d-flex align-items-center gap-2"
                  >
                    <input
                      class="form-check-input ms-0 mt-0"
                      type="radio"
                      name="shiftTypeRadio"
                      id="radioOff"
                      value="off"
                    />
                    <label
                      class="form-check-label extra-small fw-bold text-dark w-100"
                      for="radioOff"
                    >
                      <i class="fa-solid fa-mug-hot text-secondary me-1"></i>
                      Nghỉ Ca (OFF)
                    </label>
                  </div>
                </div>
              </div>

              <!-- Ghi chú phân ca -->
              <div class="mb-3">
                <label class="form-label extra-small fw-bold text-secondary"
                  >Ghi Chú Phân Ca / Lý Do Đổi Ca</label
                >
                <input
                  type="text"
                  class="form-control shadow-none extra-small"
                  id="shiftNoteInput"
                  placeholder="Ví dụ: Đổi ca do bận việc gia đình, đã thỏa thuận..."
                />
              </div>

              <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <button
                  type="button"
                  class="btn btn-light extra-small fw-semibold px-3 py-2 border rounded-3"
                  data-bs-dismiss="modal"
                >
                  Hủy
                </button>
                <button
                  type="submit"
                  class="btn btn-warning-orange text-white extra-small fw-bold px-4 py-2 rounded-3 shadow-sm"
                >
                  <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Phân Ca
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div id="toastNotification" class="toast-notification d-none">
      <div
        class="alert alert-success border-0 shadow-lg d-flex align-items-center gap-2 py-3 px-3 rounded-4 mb-0"
      >
        <i class="fa-solid fa-circle-check fs-4"></i>
        <div>
          <div class="fw-bold extra-small" id="toastTitle">Thành Công!</div>
          <div class="extra-small" id="toastMessage">
            Thông tin ca làm việc đã được cập nhật.
          </div>
        </div>
      </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/schedule.js" asp-append-version="true"></script>
  </body>
