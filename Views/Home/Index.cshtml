@{
    Layout = null;
    ViewData["Title"] = "Retail365 - Màn Hình Điểm Danh QR";
}
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5 CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    />
    <!-- Font Awesome Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <!-- QR Code Generator Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <link rel="stylesheet" href="~/css/retail365.css" asp-append-version="true" />
  </head>
  <body class="bg-light-cream min-vh-100 pb-4">
    <!-- TOP NAVIGATION BAR -->
    <nav class="navbar navbar-expand-lg bg-white border-bottom px-4 py-2 mb-3 sticky-top shadow-sm">
      <div class="container-fluid">
        <a
          class="navbar-brand d-flex align-items-center gap-2 fw-bold"
          href="/"
        >
          <div
            class="brand-icon bg-orange text-white rounded-3 d-flex align-items-center justify-content-center"
            style="width: 34px; height: 34px"
          >
            <i class="fa-solid fa-store fs-6"></i>
          </div>
          <span class="fs-6 text-dark"
            >Retail365
            <span
              class="badge bg-warning-subtle text-warning-orange border extra-small ms-1"
              >Chi Nhánh Q1 - 2104</span
            ></span
          >
        </a>

        <div class="d-flex align-items-center gap-3">
          <ul
            class="navbar-nav d-none d-md-flex flex-row gap-3 extra-small fw-semibold"
          >
            <li class="nav-item">
              <a class="nav-link text-warning-orange active fw-bold" href="/"
                ><i class="fa-solid fa-qrcode me-1"></i> Màn Hình Điểm Danh QR</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link text-secondary" href="/Schedule"
                ><i class="fa-solid fa-calendar-days me-1"></i> Bảng Phân Ca & Nhân Sự</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link text-muted" href="/Account/Login"
                ><i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Đăng Xuất / Đổi TK</a
              >
            </li>
          </ul>
          <div class="d-flex align-items-center gap-2 border-start ps-3">
            <span
              id="userRoleBadge"
              class="badge bg-secondary-subtle text-secondary extra-small px-2 py-1 rounded-pill"
            >Đang tải vai trò...</span>
          </div>
        </div>
      </div>
    </nav>

    <div class="container-fluid px-4">
      <!-- HEADER BAR: THÔNG TIN CHI NHÁNH & CA LÀM VIỆC & ĐỒNG HỒ -->
      <div class="row g-3 mb-3 align-items-center">
        <div class="col-md-5">
          <div
            class="bg-white p-3 rounded-4 border d-flex align-items-center gap-3 shadow-sm"
          >
            <div class="bg-warning-subtle text-warning-orange p-3 rounded-3">
              <i class="fa-solid fa-store fs-4"></i>
            </div>
            <div>
              <div class="extra-small text-uppercase text-muted fw-bold">
                Trạm Kiosk Quầy 01
              </div>
              <h6 class="fw-bold text-dark mb-0">Chi Nhánh Bến Nghé, Quận 1</h6>
              <small class="text-muted extra-small"
                ><i class="fa-solid fa-location-dot me-1"></i>GPS + Geofence theo cấu hình cửa hàng</small
              >
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div
            class="bg-white p-3 rounded-4 border d-flex align-items-center justify-content-between shadow-sm"
          >
            <div>
              <div class="extra-small text-uppercase text-muted fw-bold">
                Ca Vận Hành Hiện Tại
              </div>
              <h6 class="fw-bold text-dark mb-0">Ca Chiều (14:00 - 22:00)</h6>
            </div>
            <span
              class="badge bg-success-subtle text-success rounded-pill px-3 py-2"
              >4/5 Đã Đến</span
            >
          </div>
        </div>

        <div class="col-md-3">
          <div
            class="bg-dark text-white p-3 rounded-4 border shadow-sm text-center position-relative"
          >
            <div id="liveClock" class="fw-bold fs-3 text-amber font-monospace">
              00:00:00
            </div>
            <small id="liveDate" class="text-white-50 extra-small d-block"
              >---, --/--/----</small
            >
          </div>
        </div>
      </div>

      <!-- MAIN CONTENT ROW -->
      <div class="row g-3">
        <!-- CỘT TRÁI: MÃ QR ĐIỂM DANH -->
        <div class="col-lg-6">
          <div
            class="bg-white rounded-4 border p-4 shadow-sm h-100 d-flex flex-column justify-content-between"
          >
            <div>
              <div
                class="d-flex justify-content-between align-items-center mb-3"
              >
                <h6 class="fw-bold text-dark mb-0">
                  <i class="fa-solid fa-qrcode me-2 text-warning-orange"></i>Mã
                  QR Điểm Danh Động - Quầy Thu Ngân
                </h6>
                <span class="badge bg-light text-secondary border extra-small"
                  ><i class="fa-solid fa-shield-halved me-1 text-success"></i
                  >GPS bắt buộc</span
                >
              </div>

              <!-- KHU VỰC NÚT BẤM KÍCH HOẠT QUÉT QR / HIỂN THỊ QR -->
              <div
                class="qr-main-wrapper bg-light-cream rounded-4 p-4 text-center d-flex flex-column align-items-center justify-content-center position-relative min-vh-40 border border-amber-subtle"
              >
                <!-- TRẠNG THÁI BAN ĐẦU: NÚT BẤM KÍCH HOẠT -->
                <div id="qrActionPrompt" class="py-4 text-center">
                  <div class="mb-3">
                    <i
                      class="fa-solid fa-qrcode display-3 text-secondary opacity-50"
                    ></i>
                  </div>
                  <p class="text-muted small mb-4">
                    Vui lòng bấm nút bên dưới để tạo mã QR điểm danh ca làm việc
                  </p>

                  <button
                    id="btnStartCheckIn"
                    class="btn btn-warning-orange text-white fw-bold px-4 py-3 rounded-3 shadow-sm btn-lg"
                  >
                    <i class="fa-solid fa-right-to-bracket me-2"></i> Bấm để
                    Check-in Vào Ca
                  </button>
                  <button
                    id="btnStartCheckOut"
                    class="btn btn-danger text-white fw-bold px-4 py-3 rounded-3 shadow-sm btn-lg d-none"
                  >
                    <i class="fa-solid fa-right-from-bracket me-2"></i> Bấm để
                    Check-out Tan Ca
                  </button>
                </div>

                <!-- KHU VỰC HIỂN THỊ MÃ QR -->
                <div
                  id="qrDisplayArea"
                  class="d-none flex-column align-items-center w-100"
                >
                  <span
                    id="qrActionBadge"
                    class="badge bg-warning-orange text-white mb-3 px-3 py-2 fs-6"
                    ><i class="fa-solid fa-qrcode me-1"></i> MÃ QR ĐIỂM DANH CỬA HÀNG (30S)</span
                  >

                  <div
                    class="bg-white p-3 rounded-4 shadow-sm border mb-3 position-relative"
                  >
                    <div id="qrcode"></div>
                    <div
                      id="qrExpiredOverlay"
                      class="qr-overlay rounded-4 d-none align-items-center justify-content-center"
                    >
                      <span class="badge bg-danger fs-6">Mã đã hết hạn</span>
                    </div>
                  </div>

                  <div class="w-75 mb-3">
                    <div
                      class="d-flex justify-content-between extra-small text-muted mb-1"
                    >
                      <span>Mã tự làm mới sau:</span>
                      <strong id="timerText" class="text-warning-orange"
                        >30s</strong
                      >
                    </div>
                    <div class="progress" style="height: 6px">
                      <div
                        id="timerProgress"
                        class="progress-bar bg-warning-orange"
                        style="width: 100%; transition: width 1s linear"
                      ></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- 3 BƯỚC HƯỚNG DẪN -->
            <div class="row g-2 mt-3 pt-3 border-top text-center extra-small">
              <div class="col-4">
                <div class="p-2 bg-light rounded-3">
                  <span class="fw-bold text-warning-orange d-block mb-1"
                    >1. Bấm Nút</span
                  >
                  <span class="text-muted">Tạo mã QR theo tác vụ</span>
                </div>
              </div>
              <div class="col-4">
                <div class="p-2 bg-light rounded-3">
                  <span class="fw-bold text-warning-orange d-block mb-1"
                    >2. Quét Mã</span
                  >
                  <span class="text-muted">Hướng camera quét mã</span>
                </div>
              </div>
              <div class="col-4">
                <div class="p-2 bg-light rounded-3">
                  <span class="fw-bold text-warning-orange d-block mb-1"
                    >3. Hoàn Tất</span
                  >
                  <span class="text-muted">Ghi nhận giờ tự động</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CỘT PHẢI: XỬ LÝ ĐỘNG THEO ROLE -->
        <div class="col-lg-6">
          <div
            class="bg-white rounded-4 border p-4 shadow-sm h-100 d-flex flex-column justify-content-between"
          >
            <!-- GIAO DIỆN ADMIN -->
            <div id="adminView" class="role-view d-none">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                  <small class="text-muted extra-small uppercase fw-bold">DỮ LIỆU CHẤM CÔNG HÔM NAY</small>
                  <h6 class="fw-bold text-dark mb-0">Ghi nhận trực tiếp từ PostgreSQL</h6>
                </div>
                <span id="attendanceSummaryBadge" class="badge bg-warning-subtle text-warning-orange fs-6 px-3 py-2 rounded-3">0 lượt</span>
              </div>

              <div class="p-3 mb-3 border rounded-3 bg-light" id="storeLocationPanel">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                  <div>
                    <div class="fw-bold small text-dark">
                      <i class="fa-solid fa-location-crosshairs me-1 text-warning-orange"></i>
                      Vị trí chấm công STORE-01
                    </div>
                    <div id="storeLocationStatus" class="text-muted extra-small mt-1">
                      Đang kiểm tra cấu hình vị trí...
                    </div>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <label for="storeRadiusMeters" class="extra-small text-muted">Bán kính</label>
                    <div class="input-group input-group-sm" style="width: 105px">
                      <input id="storeRadiusMeters" class="form-control" type="number" min="20" max="500" value="50" />
                      <span class="input-group-text">m</span>
                    </div>
                    <button id="btnSetStoreLocation" type="button" class="btn btn-sm btn-warning-orange text-white fw-bold">
                      <i class="fa-solid fa-crosshairs me-1"></i>Đặt vị trí cửa hàng tại đây
                    </button>
                  </div>
                </div>
              </div>

              <div class="row g-2 mb-4">
                <div class="col-4">
                  <div class="p-3 bg-light rounded-3 border">
                    <div id="attendanceTotalToday" class="fs-4 fw-bold text-dark">0</div>
                    <small class="text-muted extra-small">Lượt hôm nay</small>
                  </div>
                </div>
                <div class="col-4">
                  <div class="p-3 bg-light rounded-3 border">
                    <div id="attendanceCheckedIn" class="fs-4 fw-bold text-warning-orange">0</div>
                    <small class="text-muted extra-small">Đang làm</small>
                  </div>
                </div>
                <div class="col-4">
                  <div class="p-3 bg-light rounded-3 border">
                    <div id="attendanceCompleted" class="fs-4 fw-bold text-success">0</div>
                    <small class="text-muted extra-small">Đã hoàn tất</small>
                  </div>
                </div>
              </div>

              <h6 class="fw-bold text-dark mb-3 extra-small uppercase">
                <i class="fa-solid fa-list-check me-2 text-warning-orange"></i>
                Dòng ghi nhận trực tiếp
              </h6>
              <div id="adminLiveAttendanceList" class="d-flex flex-column gap-2 mb-3">
                <div class="p-3 text-center text-muted small border rounded-3 bg-light">
                  Đang tải dữ liệu chấm công...
                </div>
              </div>
            </div>
            <!-- GIAO DIỆN EMPLOYEE -->
            <div id="employeeView" class="role-view d-none">
              <div
                class="p-3 bg-light-cream rounded-3 border border-warning-subtle mb-4 d-flex align-items-center gap-3"
              >
                <div
                  id="userAvatar"
                  class="bg-warning-orange text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5"
                  style="width: 48px; height: 48px"
                >
                  NV
                </div>
                <div>
                  <h6 id="userName" class="fw-bold text-dark mb-0">---</h6>
                  <small class="text-muted extra-small"
                    >Mã NV: <strong id="userEmpCode">---</strong> •
                    <span id="userDept">Quầy Thu Ngân 01</span></small
                  >
                </div>
              </div>

              <h6 class="fw-bold text-dark mb-3 extra-small uppercase">
                <i
                  class="fa-solid fa-clock-rotate-left me-2 text-warning-orange"
                ></i
                >Lịch Sử Vào Ca / Tan Ca Của Bạn
              </h6>

              <div id="personalHistoryList" class="d-flex flex-column gap-2">
                <!-- Item lịch sử cá nhân sẽ được tạo động khi quét QR -->
              </div>
            </div>

            <!-- FOOTER CỘT PHẢI -->
            <div
              class="pt-3 border-top d-flex justify-content-between align-items-center extra-small text-muted mt-3"
            >
              <span>Đang kết nối POS Kiosk #01</span>
              <span>Hotline hỗ trợ: <strong>1900 6828</strong></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
  </body>
</html>
