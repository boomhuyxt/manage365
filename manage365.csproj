<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e867aab8-31bf-4e44-acc6-427981e8c257</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lyntai.Storage.Postgres" Version="3.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="manage365.Tests\**\*.cs" />
    <Compile Remove="tools\BleScannerAgent\**\*.cs" />
    <Compile Remove="artifacts\**\*.cs" />
    <Content Remove="tools\BleScannerAgent\**\*" />
    <Content Remove="artifacts\**\*" />
    <EmbeddedResource Remove="tools\BleScannerAgent\**\*" />
    <EmbeddedResource Remove="artifacts\**\*" />
    <None Remove="tools\BleScannerAgent\**\*" />
    <None Remove="artifacts\**\*" />
    <Content Remove="manage365.Tests\**\*" />
    <EmbeddedResource Remove="manage365.Tests\**\*" />
    <None Remove="manage365.Tests\**\*" />
  </ItemGroup>

  <ItemGroup Condition="Exists('tools/BleScannerAgent/package/BleScannerAgent.zip')">
    <Content Include="tools/BleScannerAgent/package/BleScannerAgent.zip" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('tools/BleScannerAgent/package/Retail365-BLE-Setup.exe')">
    <Content Include="tools/BleScannerAgent/package/Retail365-BLE-Setup.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
